diff --git a/src/components/landing/headline-font-kind.ts b/src/components/landing/headline-font-kind.ts
deleted file mode 100644
index 5967612..0000000
--- a/src/components/landing/headline-font-kind.ts
+++ /dev/null
@@ -1,17 +0,0 @@
-/**
- * Which display face the hero headline uses, per locale.
- *
- * Latin-script locales (en, tr) use the repaired AMCAP Eternal —
- * see headline-fonts.ts for why the font file itself had to be
- * patched before it could render Turkish. Arabic uses Noto Kufi
- * Arabic Black, the heavy geometric Arabic face that matches
- * AMCAP's blocky spirit (AMCAP has no Arabic glyphs at all).
- *
- * Kept as a pure function in its own module so it can be unit
- * tested without loading the font machinery.
- */
-export type HeadlineFontKind = "amcap" | "kufi";
-
-export function headlineFontKind(locale: string): HeadlineFontKind {
-  return locale === "ar" ? "kufi" : "amcap";
-}
diff --git a/src/components/landing/headline-fonts.ts b/src/components/landing/headline-fonts.ts
deleted file mode 100644
index 14cd4f3..0000000
--- a/src/components/landing/headline-fonts.ts
+++ /dev/null
@@ -1,36 +0,0 @@
-import localFont from "next/font/local";
-
-import { headlineFontKind } from "./headline-font-kind";
-
-/**
- * Self-hosted display fonts for the landing hero headline.
- *
- * AMCAP Eternal (The Fontry) is the heavy all-caps display face
- * the product owner chose. The free release cannot render
- * Turkish as shipped: its lowercase accented slots (ç, ö, ü, ı)
- * all point at a smiley-face easter-egg glyph, and ğ / ş / İ do
- * not exist at all. The bundled AmcapTR.otf is the same font
- * with those letters repaired — ç/ö/ü remapped to the font's own
- * (correct) capitals, ı to its plain bar, Ğ built from G plus a
- * breve, Ş from S plus the font's cedilla, İ from I plus its dot.
- * AMCAP Eternal is free for personal use; a commercial launch
- * needs the paid licence from The Fontry.
- *
- * The Kufi file is a static Black (900) instance of Noto Kufi
- * Arabic, subset to the Arabic script ranges.
- */
-const amcapHeadlineFont = localFont({
-  src: "../../assets/fonts/AmcapTR.otf",
-  display: "swap",
-});
-
-const kufiHeadlineFont = localFont({
-  src: "../../assets/fonts/NotoKufiArabic-Black.ttf",
-  display: "swap",
-});
-
-export function headlineFontClassName(locale: string): string {
-  return headlineFontKind(locale) === "kufi"
-    ? kufiHeadlineFont.className
-    : amcapHeadlineFont.className;
-}
diff --git a/src/tests/headline-fonts.test.ts b/src/tests/headline-fonts.test.ts
deleted file mode 100644
index d935fb2..0000000
--- a/src/tests/headline-fonts.test.ts
+++ /dev/null
@@ -1,18 +0,0 @@
-import { describe, expect, it } from "vitest";
-
-import { headlineFontKind } from "@/components/landing/headline-font-kind";
-
-describe("headlineFontKind", () => {
-  it("uses the kufi display face for Arabic", () => {
-    expect(headlineFontKind("ar")).toBe("kufi");
-  });
-
-  it("uses AMCAP for the Latin-script locales", () => {
-    expect(headlineFontKind("tr")).toBe("amcap");
-    expect(headlineFontKind("en")).toBe("amcap");
-  });
-
-  it("falls back to AMCAP for unknown locales", () => {
-    expect(headlineFontKind("de")).toBe("amcap");
-  });
-});
