# SMART MARKETING PLATFORM — Environment Configuration (WEB-01-01)
# NestJS Backend REST API Base URL (client never connects directly to PostgreSQL)
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# API Mode: "mock" (explicit development mock adapter) | "live" (real NestJS API)
NEXT_PUBLIC_API_MODE=mock

# Default application locale: "en" | "tr" | "ar"
NEXT_PUBLIC_DEFAULT_LOCALE=en
